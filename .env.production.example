# USM production environment template
# Copy to /var/www/usmo/.env on the VPS and replace every CHANGE_ME value.
# Never commit the populated file.

# Public routing. Values are hostnames only: no scheme, path, commas, or quotes.
# Leave APP_DOMAIN/API_DOMAIN empty until DNS exists; Nginx will stay available
# over HTTP with server_name _ instead of entering a restart loop.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
NGINX_SERVER_NAMES=app.example.com api.example.com

# auto: use HTTPS only when valid certificate files are mounted
# off: always serve HTTP (useful during first certificate issuance)
# required: fail fast unless all configured certificates exist
NGINX_HTTPS_MODE=auto
NGINX_CLIENT_MAX_BODY_SIZE=350m
LETSENCRYPT_EMAIL=you@example.com

# Browser/server public URLs. Same-origin /api is the safest default. If a
# dedicated API hostname is used, set NEXT_PUBLIC_API_URL=https://api.example.com/api.
NEXT_PUBLIC_API_URL=/api
SITE_URL=https://app.example.com
CLIENT_URL=https://app.example.com
# Relative media URLs are served by Nginx without exposing MinIO itself.
MINIO_PUBLIC_URL=/usm-media

# Internal database connection (Docker service name, not localhost).
MONGODB_URI=mongodb://mongo:27017/usmo

# Required. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Required. Do not use local-development credentials in production.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MINIO_BUCKET=usm-media
