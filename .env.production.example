# =============================================================================
# USM Platform — PRODUCTION environment template
# =============================================================================
# Copy this file to `.env.production` on the VPS ONLY (in /var/www/usmo),
# fill in real values, and never commit the filled-in copy.
# docker-compose.prod.yml reads this automatically if it's named `.env`
# in the same directory — on the VPS, symlink or copy it:
#   cp .env.production.example .env.production
#   ln -sf .env.production .env
# =============================================================================

# ── Domains (no defaults — you must set these) ───────────────────────────────
# Public site (Next.js)
APP_DOMAIN=app.example.com
# API (NestJS + reverse-proxied MinIO media)
API_DOMAIN=api.example.com
# Optional: only needed if you want the admin panel reachable on its own
# hostname instead of https://$APP_DOMAIN/admin (same Next.js app either way).
# ADMIN_DOMAIN=admin.example.com

# Email used for Let's Encrypt registration / expiry notices
LETSENCRYPT_EMAIL=you@example.com

# ── Database ──────────────────────────────────────────────────────────────────
# Leave as-is to use the bundled `mongo` container (internal network only).
# Point this at an external cluster (e.g. Atlas) instead if you don't want
# compose managing MongoDB.
MONGODB_URI=mongodb://mongo:27017/usmo

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# ── MinIO object storage ───────────────────────────────────────────────────────
# Required. Do not use the local-dev defaults (minioadmin/minioadmin123) in production.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MINIO_BUCKET=usm-media
