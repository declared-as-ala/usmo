# =============================================================================
# USM Platform — Nginx reverse proxy (production)
# =============================================================================
# This is a template: nginx:alpine's docker-entrypoint runs `envsubst` on every
# *.template file in /etc/nginx/templates/ and writes the result into
# /etc/nginx/conf.d/ before nginx starts, substituting ${APP_DOMAIN},
# ${API_DOMAIN}, ${MINIO_BUCKET} from the container's environment
# (see docker-compose.prod.yml's nginx service).
#
# Until certificates exist at /etc/letsencrypt/live/$API_DOMAIN and
# .../$APP_DOMAIN, the HTTPS server blocks below will fail to start — run the
# certbot `certonly --webroot` command (see docker-compose.prod.yml comments)
# against the plain HTTP block first, then restart nginx.
# =============================================================================

# ── HTTP — ACME challenge + redirect everything else to HTTPS ───────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS — Next.js frontend ─────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 25m;

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (Next.js dev HMR isn't used in prod, but this keeps
        # any future websocket/streaming route working through the proxy).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

# ── HTTPS — NestJS API (+ public MinIO media, reverse-proxied) ─────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Product photos, media library uploads, etc. — matches MINIO_BUCKET so
    # MINIO_PUBLIC_URL=https://$API_DOMAIN/$MINIO_BUCKET resolves here instead
    # of exposing MinIO's port 9000 directly to the internet.
    client_max_body_size 25m;

    location /${MINIO_BUCKET}/ {
        proxy_pass http://minio:9000/${MINIO_BUCKET}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://api:3001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
